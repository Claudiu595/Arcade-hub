@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar" style="display: flex; flex-direction: column; justify-content: center; height: 100vh;">
        <div style="flex: 0 1 auto;">
            <NavMenu />
        </div>
    </div>

    <main style="display: flex; flex-direction: column; justify-content: center; align-items: center; height: 100vh; width: 100%; overflow-y: auto; background-color: #f8f9fa;">
        <div class="px-4" style="width: 100%; max-width: 800px; display: flex; flex-direction: column; align-items: center; justify-content: center;">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>