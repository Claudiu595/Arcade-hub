<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').checked = false">
    <nav class="nav-menu">
        <div class="search-panel">
            <input
                class="game-search"
                type="search"
                placeholder="Search games..."
                aria-label="Search games"
                value="@searchText"
                @oninput="OnSearchChanged" />

            @if (!string.IsNullOrWhiteSpace(searchText) && !FilteredGames.Any())
            {
                <div class="no-results">No games found</div>
            }
        </div>

        <div class="game-buttons">
            @foreach (var game in FilteredGames)
            {
                <div class="nav-item">
                    <NavLink class="nav-link" href="@game.Href">
                        <span class="bi @game.Icon" aria-hidden="true"></span> @game.Label
                    </NavLink>
                </div>
            }
        </div>

        <div class="nav-item home-button">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private string searchText = string.Empty;

    private readonly List<GameMenuItem> gameItems =
    [
        new("Pacman Escape", "/pacman", "bi-ghost-nav-menu"),
        new("Snake Game", "/snake", "bi-activity-nav-menu"),
        new("Tic-Tac-Toe", "/tictactoe", "bi-grid-3x3-gap-fill-nav-menu")
    ];

    private IEnumerable<GameMenuItem> FilteredGames =>
        string.IsNullOrWhiteSpace(searchText)
            ? gameItems.OrderBy(game => game.Label, StringComparer.OrdinalIgnoreCase)
            : gameItems
                .Where(game => game.Label.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                .OrderBy(game => game.Label, StringComparer.OrdinalIgnoreCase);

    private void OnSearchChanged(ChangeEventArgs args)
    {
        searchText = args?.Value?.ToString() ?? string.Empty;
    }

    private sealed record GameMenuItem(string Label, string Href, string Icon);
}